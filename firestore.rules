rules_version = '2';

// Rollenmodell (siehe Umbauplan "User-Accounts"):
//  - Custom Claims am Auth-Token: role ("admin"|"lead"|"member"|"viewer"), employeeId.
//    "viewer" = reiner Lesemodus: liest alles ausser dem persoenlichen Board (todos), schreibt nirgends.
//    Gesetzt ausschliesslich von der Cloud Function inviteUser (Admin SDK).
//  - employees/{id}.ancestors enthaelt die IDs aller Vorgesetzten (von
//    onStructureChange berechnet). Zugriff: selbst, Vorgesetzter (ancestor) oder Admin.
//  - Alles, was nicht ausdruecklich erlaubt ist, ist verboten.
//
// ACHTUNG: erst deployen, wenn alle Accounts existieren und die Daten migriert sind
// (solange die alte App noch finova/* nutzt, wuerde das Deployen sie aussperren).
service cloud.firestore {
  match /databases/{database}/documents {

    // Wer sein Startpasswort noch nicht geaendert hat (Claim mustChangePassword), darf nichts lesen/schreiben.
    // Nur Konten mit gueltiger Rolle (Claims von inviteUser/createAccount) — alte anonyme Logins ohne Claims haben keinen Zugriff.
    // Wer aus dem Strukturbaum entfernt wurde (employees/{id}.active == false), verliert den Zugriff sofort,
    // auch wenn sein Token noch bis zu eine Stunde gueltig ist. Konten ohne Mitarbeiter-Verknuepfung (Admin) bleiben unberuehrt.
    function stillActive() {
      return request.auth.token.get('employeeId', '') == ''
        || !exists(/databases/$(database)/documents/employees/$(request.auth.token.get('employeeId', '')))
        || get(/databases/$(database)/documents/employees/$(request.auth.token.get('employeeId', ''))).data.get('active', true) != false;
    }
    function signedIn() {
      return request.auth != null
        && request.auth.token.get('role', '') in ['admin', 'lead', 'member', 'viewer']
        && !request.auth.token.get('mustChangePassword', false)
        && stillActive();
    }
    function role() { return request.auth.token.get('role', ''); }
    function myEmp() { return request.auth.token.get('employeeId', ''); }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isViewer() { return signedIn() && role() == 'viewer'; }
    // Der Lesemodus hat in den Regeln keine eigene Identitaet: auch mit verknuepftem Mitarbeiter schreibt er nirgends.
    function isSelf(empId) { return signedIn() && role() != 'viewer' && myEmp() != '' && myEmp() == empId; }
    function isAncestor(ancestors) { return signedIn() && role() != 'viewer' && myEmp() != '' && myEmp() in ancestors; }

    function empDoc(empId) {
      return get(/databases/$(database)/documents/employees/$(empId));
    }
    // Zugriff auf Daten, die einem Mitarbeiter gehoeren (self / Vorgesetzte / Admin).
    function canAccessEmployee(empId) {
      return isAdmin() || isSelf(empId) || isAncestor(empDoc(empId).data.ancestors);
    }

    // Lesen darf zusaetzlich der Lesemodus; Schreiben bleibt bei canAccessEmployee.
    function canReadEmployee(empId) {
      return isViewer() || canAccessEmployee(empId);
    }

    // Nur Admin/Function duerfen Struktur und Identitaet aendern.
    function lockedFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['managerId', 'ancestors', 'uid', 'accountPending', 'role', 'name', 'email', 'active', 'createdAt', 'monthStats']);
    }

    // Den Bonus (€) setzen Vorgesetzte/Admin, nicht die Person selbst.
    function bonusUntouchedOrManager() {
      return myEmp() in resource.data.ancestors
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['bonus']);
    }

    // Plausibilitaet der Zahlen, die Mitarbeiter und Vorgesetzte selbst schreiben (Admin und Functions sind frei).
    // Bewusst knapp gehalten: Firestore bricht eine Regelauswertung bei mehr als 1000 Ausdruecken ab (= alles abgelehnt).
    function num(v) { return v is number && math.abs(v) < 10000000; }
    function validCareerUnits(d) {
      let c = d.get('careerUnits', {});
      return c is map && c.keys().hasOnly(['insurance', 'investment', 'credit', 'realestate'])
        && num(c.get('insurance', 0)) && num(c.get('investment', 0))
        && num(c.get('credit', 0)) && num(c.get('realestate', 0));
    }
    function validEhByPlan(d) {
      let e = d.get('ehByPlan', {});
      return e is map && e.keys().hasOnly(['insurance', 'investment', 'investmentVb', 'credit', 'realestate'])
        && num(e.get('insurance', 0)) && num(e.get('investment', 0)) && num(e.get('investmentVb', 0))
        && num(e.get('credit', 0)) && num(e.get('realestate', 0));
    }
    function validEmployeeData(d) {
      return num(d.get('soll', 0)) && num(d.get('ist', 0))
        && num(d.get('at', 0)) && num(d.get('bt', 0)) && num(d.get('et', 0))
        && num(d.get('atPlan', 0)) && num(d.get('atIst', 0)) && num(d.get('btPlan', 0)) && num(d.get('btIst', 0))
        && num(d.get('stPlan', 0)) && num(d.get('stIst', 0)) && num(d.get('etPlan', 0)) && num(d.get('etIst', 0))
        && num(d.get('bonus', 0))
        && validCareerUnits(d) && validEhByPlan(d)
        && d.get('vbByAbwickler', {}) is map
        && (!('joinDate' in d) || (d.joinDate is string && d.joinDate.size() <= 10))
        && d.get('isNew', false) is bool;
    }
    // Der Karrierezaehler (loest Stufenaufstiege und damit hoehere Saetze aus) darf bei der Person selbst nur steigen;
    // zuruecksetzen koennen ihn Vorgesetzte und Admin (Storno/Korrektur).
    function careerNotLoweredBySelf(empId) {
      return myEmp() != empId
        || (request.resource.data.get('careerUnits', {}).get('insurance', 0) >= resource.data.get('careerUnits', {}).get('insurance', 0)
          && request.resource.data.get('careerUnits', {}).get('investment', 0) >= resource.data.get('careerUnits', {}).get('investment', 0)
          && request.resource.data.get('careerUnits', {}).get('credit', 0) >= resource.data.get('careerUnits', {}).get('credit', 0)
          && request.resource.data.get('careerUnits', {}).get('realestate', 0) >= resource.data.get('careerUnits', {}).get('realestate', 0));
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /employees/{empId} {
      // Stammdaten und Monatssummen (Einheiten, AT/BT/ST/ET) sehen alle Eingeloggten;
      // Planung, Anwesenheit, Todos und Konto-Daten (Subcollections) bleiben geschuetzt.
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || ((isSelf(empId) || isAncestor(resource.data.ancestors)) && lockedFieldsUntouched() && bonusUntouchedOrManager()
          && validEmployeeData(request.resource.data) && careerNotLoweredBySelf(empId));

      // Konto-Daten (uid, E-Mail, "wartet auf erste Anmeldung"): nur self/Vorgesetzte/Admin und der Lesemodus lesen,
      // geschrieben ausschliesslich von den Cloud Functions (Admin SDK umgeht die Regeln).
      match /private/{id} {
        allow read: if canReadEmployee(empId);
        allow write: if false;
      }

      match /planWeeks/{id} {
        allow read: if canReadEmployee(empId);
        allow write: if canAccessEmployee(empId);
      }
      match /planMonthNotes/{id} {
        allow read: if canReadEmployee(empId);
        allow write: if canAccessEmployee(empId);
      }
      match /planAnnual/{id} {
        allow read: if canReadEmployee(empId);
        allow write: if canAccessEmployee(empId);
      }
      match /attendance/{id} {
        allow read: if canReadEmployee(empId);
        allow write: if canAccessEmployee(empId);
      }
      // Persoenliches Board: nur der Besitzer (auch Vorgesetzte und Admin nicht).
      match /todos/{id} {
        allow read, write: if isSelf(empId);
      }
    }

    // Finanzierungsfaelle: ownerId = Betreuer, ancestors = dessen Vorgesetzte
    // (muss mit employees/{ownerId}.ancestors uebereinstimmen, damit niemand
    // per Client Fremde als "Vorgesetzte" eintragen kann).
    match /financings/{caseId} {
      // Abwickler (abwicklerId) sehen und bearbeiten die ihnen zugewiesenen Faelle,
      // koennen aber weder Betreuer noch Abwickler noch ancestors aendern.
      function isAbwickler(data) { return isSelf(data.get('abwicklerId', '')); }
      // abwicklerId: leer oder die ID eines vorhandenen Mitarbeiters (sonst koennte der Betreuer Fremden beliebige IDs freigeben).
      function abwicklerOk(data) {
        return !('abwicklerId' in data) || (data.abwicklerId is string
          && (data.abwicklerId == ''
            || (data.abwicklerId.matches('[A-Za-z0-9_-]{1,64}')
              && exists(/databases/$(database)/documents/employees/$(data.abwicklerId)))));
      }
      allow read: if isViewer() || isAdmin() || isSelf(resource.data.ownerId) || isAncestor(resource.data.ancestors)
        || isAbwickler(resource.data);
      allow create: if (isAdmin() || canAccessEmployee(request.resource.data.ownerId))
        && request.resource.data.ancestors == empDoc(request.resource.data.ownerId).data.ancestors
        && abwicklerOk(request.resource.data);
      // Aendern: wer den Fall heute sehen darf. Betreuerwechsel (ownerId) ist erlaubt,
      // sofern die neuen ancestors exakt zum neuen Besitzer passen und der Aendernde
      // auf diesen Besitzer zugreifen darf.
      allow update: if abwicklerOk(request.resource.data) && (
        ((isAdmin() || isSelf(resource.data.ownerId) || isAncestor(resource.data.ancestors))
          && ((request.resource.data.ownerId == resource.data.ownerId
                && request.resource.data.ancestors == resource.data.ancestors)
              || (canAccessEmployee(request.resource.data.ownerId)
                && request.resource.data.ancestors == empDoc(request.resource.data.ownerId).data.ancestors)))
        || (isAbwickler(resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.ancestors == resource.data.ancestors
          && request.resource.data.get('abwicklerId', '') == resource.data.get('abwicklerId', '')));
      allow delete: if isAdmin() || isSelf(resource.data.ownerId) || isAncestor(resource.data.ancestors);
    }

    // Umsatzverfolgung (Controlling): eine Zeile je gebuchter Rechner-Position. ownerId = Mitarbeiter, auf den
    // gebucht wurde, ancestors = dessen Vorgesetzte (muss zu employees/{ownerId}.ancestors passen).
    // Nachtraeglich aenderbar sind nur Kunde, Beginn, policiert und ausbezahlt.
    match /sales/{id} {
      allow read: if isViewer() || isAdmin() || isSelf(resource.data.ownerId) || isAncestor(resource.data.ancestors);
      allow delete: if isAdmin() || isSelf(resource.data.ownerId) || isAncestor(resource.data.ancestors);
      allow create: if (isAdmin() || canAccessEmployee(request.resource.data.ownerId))
        && request.resource.data.ancestors == empDoc(request.resource.data.ownerId).data.ancestors;
      allow update: if (isAdmin() || isSelf(resource.data.ownerId) || isAncestor(resource.data.ancestors))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['kunde', 'beginn', 'policiert', 'ausbezahlt']);
    }

    // Konfetti bei Umsatzbuchungen: jeder Eingeloggte meldet eine Buchung (nur name + Zeitpunkt, unveraenderlich),
    // alle lesen mit und loesen damit den Konfettiregen aus.
    match /celebrations/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && !isViewer()
        && request.resource.data.keys().hasOnly(['name', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.at is number;
      allow update, delete: if false;
    }

    // Strukturbaum, Saetze, Teamziel: alle Eingeloggten lesen, nur Admin schreibt.
    match /org/{docId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      // Loeschen + Neuanlegen wuerde die Rueckschritt-Sperren unten umgehen.
      allow delete: if isAdmin() && !(docId in ['teamGoal', 'archiveIndex']);
      // teamGoal/archiveIndex: eigene, strengere Update-Regeln unten (Regeln werden mit ODER verknuepft).
      allow update: if isAdmin() && !(docId in ['teamGoal', 'archiveIndex']);
    }
    // Schutz vor "alter Stand ueberschreibt neuen" (z. B. veralteter Admin-Tab): Teamziel darf nicht auf einen
    // frueheren Monat zurueck und der Verlauf nicht kuerzer werden; das Archiv darf keine Monate verlieren.
    // Die Cloud Functions (Admin SDK) sind davon nicht betroffen. Spezifischere Regel, gilt zusaetzlich zu oben.
    match /org/teamGoal {
      allow update: if isAdmin()
        && request.resource.data.get('teamGoal', {}).get('periodStart', '') >= resource.data.get('teamGoal', {}).get('periodStart', '')
        && request.resource.data.get('history', []).size() >= resource.data.get('history', []).size();
    }
    match /org/archiveIndex {
      allow update: if isAdmin()
        && request.resource.data.get('months', []).size() >= resource.data.get('months', []).size();
    }

    // Monatsarchiv: Monatsabschluss schreibt der Admin (Client); danach unveraendert.
    // Meta-Dokument (Teamziel, Strukturbaum des Monats): alle Eingeloggten lesen.
    match /snapshots/{month} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
    match /snapshots/{month}/employees/{empId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
