rules_version = '2';

// Profilbilder: avatars/{employeeId}.webp. Lesen duerfen alle Eingeloggten (Rolle per Claim, wie in firestore.rules),
// schreiben nur die Person selbst (Claim employeeId) oder ein Admin; klein (< 200 KB) und nur Bilder.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && request.auth.token.get('role', '') in ['admin', 'lead', 'member']
        && !request.auth.token.get('mustChangePassword', false);
    }
    function mayWrite(file) {
      return signedIn()
        && (request.auth.token.role == 'admin'
            || (request.auth.token.get('employeeId', '') != '' && file == request.auth.token.employeeId + '.webp'));
    }

    match /avatars/{file} {
      allow read: if signedIn();
      allow create, update: if mayWrite(file)
        && request.resource.size < 200 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if mayWrite(file);
    }
  }
}
